# Copy to .env before running `bun run dev` (the dev script loads it via --env-file=.env).
#   cp .env.example .env
# Cross-check: turbo.json `globalPassThroughEnv` lists every env var the build recognizes.

# Local Platform runtime
PORT=3001
FS_HOST=127.0.0.1
WEB_HOST=127.0.0.1
WEB_PORT=3000
VITE_SERVER_URL=http://127.0.0.1:3001

# Optional extra browser origins. Launchers always trust the active WEB_HOST/WEB_PORT.
# SERVER_ALLOWED_ORIGINS=http://custom.local:4000

# Filesystem server behavior
FS_WATCH=true
FS_TREE_CONCURRENCY=32
FS_DEV_MAX_TEXT_FILE_BYTES=209715200

# Platform observability (structured JSONL logs under logs/)
OBSERVABILITY_ENABLED=true
OBSERVABILITY_SERVICE=platform
OBSERVABILITY_DIR=logs
OBSERVABILITY_CONSOLE=true
OBSERVABILITY_FILE_PRETTY=false
OBSERVABILITY_INFO_SAMPLE_RATE=100
OBSERVABILITY_SLOW_MS=500
OBSERVABILITY_MAX_FILES=14
OBSERVABILITY_MAX_SIZE_BYTES=10485760
OBSERVABILITY_BATCH_SIZE=50
OBSERVABILITY_BATCH_INTERVAL_MS=5000
OBSERVABILITY_MAX_BUFFER_SIZE=1000

# PostHog observability drain (optional)
# optional — only needed when OBSERVABILITY_POSTHOG_ENABLED=true.
# When OBSERVABILITY_POSTHOG_ENABLED is unset, the drain auto-enables only if
# POSTHOG_API_KEY is set, so a fresh clone works without any PostHog setup.
POSTHOG_API_KEY=
# OBSERVABILITY_POSTHOG_ENABLED=true
OBSERVABILITY_POSTHOG_HOST=https://eu.i.posthog.com
OBSERVABILITY_POSTHOG_MODE=logs
OBSERVABILITY_POSTHOG_EVENT_NAME=platform_log

# Settings storage. The settings document and the secret store are separate
# files on purpose: the document is served raw to the JSON editor and copied by
# export, so provider environment values must not live in it.
# Defaults: ~/.platform/settings.json and ~/.platform/secrets.json (mode 0600).
# PLATFORM_SETTINGS_FILE=
# PLATFORM_SECRETS_FILE=

# Policy layer: JSON object of setting id to value, applied over every other
# layer and refused for writes. Parsed strictly — a malformed policy is an
# operator error, not a user's, so it fails loudly instead of being ignored.
# PLATFORM_SETTINGS_POLICY={"editor.fontSize":14}
