{
  "name": "platform",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/contracts",
      "packages/observability",
      "packages/pierre/packages/path-store",
      "packages/pierre/packages/tree-test-data",
      "packages/pierre/packages/trees",
      "packages/ui",
      "../Editor/packages/*"
    ],
    "catalog": {
      "@arethetypeswrong/core": "0.18.2",
      "@pierre/vscode-icons": "0.0.9",
      "@playwright/test": "1.51.1",
      "@radix-ui/react-dropdown-menu": "2.1.16",
      "@types/jsdom": "28.0.1",
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3",
      "autoprefixer": "10.4.22",
      "jsdom": "26.1.0",
      "mitata": "1.0.34",
      "postcss": "8.5.6",
      "preact": "11.0.0-beta.0",
      "preact-render-to-string": "6.6.5",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "tsdown": "0.15.11",
      "typescript": "5.9.2",
      "vite": "npm:rolldown-vite@7.1.12"
    }
  },
  "scripts": {
    "build": "bun scripts/prod.ts build",
    "dev": "bun --env-file=.env scripts/dev.ts",
    "dev:web": "bun --env-file=.env scripts/dev.ts --filter=!desktop",
    "diagram": "bun apps/web/scripts/generate-layout-evolution-diagram.ts",
    "desktop:dev": "bun --env-file=.env scripts/desktop-dev.ts",
    "lint": "turbo lint",
    "prod": "bun scripts/prod.ts",
    "start": "bun scripts/prod.ts start",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dupes": "jscpd apps packages",
    "dupes:report": "jscpd apps packages --reporters html,console --output ./jscpd-report",
    "unused:exports": "knip --exports --no-config-hints",
    "unused:files": "knip --files --no-config-hints",
    "hooks:install": "lefthook install",
    "hooks:pre-commit": "lefthook run pre-commit"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "jscpd": "^4.2.4",
    "knip": "^6.16.0",
    "lefthook": "^2.1.9",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.10"
}
