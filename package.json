{
  "name": "platform",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/contracts",
    "packages/ui",
    "../Editor/packages/*"
  ],
  "scripts": {
    "build": "bun scripts/prod.ts build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=!desktop",
    "desktop:dev": "bun run --cwd apps/desktop dev:standalone",
    "lint": "turbo lint",
    "prod": "bun scripts/prod.ts",
    "start": "bun scripts/prod.ts start",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify:spelling": "bash scripts/verify-no-refrences.sh"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "@pierre/trees@1.0.0-beta.3": "patches/@pierre%2Ftrees@1.0.0-beta.3.patch"
  }
}
