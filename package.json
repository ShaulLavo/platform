{
  "name": "platform",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/contracts",
      "packages/observability",
      "packages/tree",
      "packages/ui"
    ],
    "catalog": {
      "preact": "11.0.0-beta.0",
      "preact-render-to-string": "6.7.0",
      "vite": "8.0.16",
      "vitest": "4.1.8"
    }
  },
  "scripts": {
    "build": "bun scripts/prod.ts build",
    "dev": "bun --env-file=.env scripts/dev.ts",
    "dev:web": "bun --env-file=.env scripts/dev.ts --filter=!desktop",
    "desktop:dev": "bun --env-file=.env scripts/desktop-dev.ts",
    "lint": "bun run --filter '*' lint",
    "prod": "bun scripts/prod.ts",
    "bench:workspace-search": "bun apps/server/scripts/workspace-search-benchmark.ts",
    "start": "bun scripts/prod.ts start",
    "format": "bun run --filter '*' format",
    "format:check": "bun run --filter '*' format:check",
    "typecheck": "bun run --sequential --filter '*' typecheck",
    "test": "bun run test:scripts && bun run --filter '*' test",
    "settings:reference": "bun scripts/generate-settings-reference.ts",
    "test:scripts": "bun --bun vitest run scripts/runtime-network.test.ts --environment node",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "dupes": "jscpd apps packages",
    "dupes:report": "jscpd apps packages --reporters html,console --output ./jscpd-report",
    "unused:exports": "knip --exports --no-config-hints",
    "unused:files": "knip --files --no-config-hints",
    "hooks:install": "lefthook install",
    "hooks:pre-commit": "lefthook run pre-commit"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "evlog": "^2.19.1",
    "jscpd": "^5.0.9",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "oxc-plugin-react-compiler": "^0.2.0",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  },
  "overrides": {
    "@singapor/core": "link:@singapor/core",
    "@singapor/decode": "link:@singapor/decode",
    "@singapor/diff": "link:@singapor/diff",
    "@singapor/find": "link:@singapor/find",
    "@singapor/gutters": "link:@singapor/gutters",
    "@singapor/lsp": "link:@singapor/lsp",
    "@singapor/lsp-plugin": "link:@singapor/lsp-plugin",
    "@singapor/minimap": "link:@singapor/minimap",
    "@singapor/panes": "link:@singapor/panes",
    "@singapor/react": "link:@singapor/react",
    "@singapor/scope-lines": "link:@singapor/scope-lines",
    "@singapor/tree-sitter": "link:@singapor/tree-sitter",
    "@singapor/tree-sitter-languages": "link:@singapor/tree-sitter-languages",
    "@singapor/typescript-lsp": "link:@singapor/typescript-lsp",
    "brace-expansion": "5.0.6",
    "dompurify": "3.4.11",
    "esbuild": "0.28.1",
    "undici": "7.28.0",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.10",
  "//singapor-links": "The @singapor/* `link:` overrides above resolve through a `bun link` registration pointing at the sibling ../../Editor checkout — there is no npm fallback (@singapor/decode is unpublished). CI reproduces that by cloning ShaulLavo/singapor as a sibling, building it, and linking each package; see .github/actions/setup/action.yml.",
  "patchedDependencies": {
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch"
  }
}
