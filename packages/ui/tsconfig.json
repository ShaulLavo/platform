{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // UI package targets ES2022 rather than the template's ES2023.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@workspace/ui/*": ["./src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
