{
  "name": "@workspace/tree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/style.css"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles/*": "./src/styles/*",
    "./utils/*": "./src/utils/*.ts",
    "./utils/model/*": "./src/utils/model/*.ts",
    "./utils/path-store/*": "./src/utils/path-store/*.ts",
    "./utils/path-store/internal/*": "./src/utils/path-store/internal/*.ts",
    "./utils/render/*": "./src/utils/render/*.ts"
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "evlog": "^2.17.0",
    "preact": "catalog:",
    "preact-render-to-string": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitest/browser": "^3.2.4",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "happy-dom": "^20.10.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "playwright": "^1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "catalog:",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
