{
  "name": "@workspace/tree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/style.css"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles/*": "./src/styles/*",
    "./utils/*": "./src/utils/*.ts",
    "./utils/model/*": "./src/utils/model/*.ts",
    "./utils/path-store/*": "./src/utils/path-store/*.ts",
    "./utils/path-store/internal/*": "./src/utils/path-store/internal/*.ts",
    "./utils/render/*": "./src/utils/render/*.ts"
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "evlog": "^2.19.1",
    "preact": "catalog:",
    "preact-render-to-string": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "@vitest/browser-playwright": "^4.1.8",
    "happy-dom": "^20.10.3",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "playwright": "^1.59.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
