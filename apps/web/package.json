{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/run-with-env.ts vite",
    "build": "tsgo --build && bun --env-file=../../.env vite build",
    "bench:editor-scroll": "node scripts/editor-scroll-benchmark.mjs",
    "bench:editor-scroll:gate": "node scripts/editor-scroll-benchmark.mjs --gate --browsers=chromium",
    "bench:editor-scroll:gate:all": "node scripts/editor-scroll-benchmark.mjs --gate --browsers=chromium,webkit,firefox",
    "bench:editor-scroll:huge": "node scripts/generate-bench-fixture.mjs && node scripts/editor-scroll-benchmark.mjs --file=.bench-fixtures/huge.ts --start-fraction=0.5 --page-timeout-ms=180000 --app-url=http://localhost:3000/",
    "bench:editor-typing": "node scripts/editor-typing-benchmark.mjs",
    "bench:editor-typing:gate": "node scripts/editor-typing-benchmark.mjs --gate --browsers=chromium",
    "bench:editor-typing:gate:all": "node scripts/editor-typing-benchmark.mjs --gate --browsers=chromium,webkit,firefox",
    "bench:editor-typing:huge": "node scripts/generate-bench-fixture.mjs && node scripts/editor-typing-benchmark.mjs --file=.bench-fixtures/huge.ts --start-fraction=0.5 --page-timeout-ms=180000 --app-url=http://localhost:3000/",
    "bench:fixture": "node scripts/generate-bench-fixture.mjs",
    "diagram": "bun scripts/generate-layout-evolution-diagram.ts",
    "start": "bun --env-file=../../.env vite preview",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun --bun vitest run --project node --project dom",
    "test:watch": "bun --bun vitest --project node --project dom",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsgo --build",
    "preview": "bun --env-file=../../.env vite preview"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.4.0",
    "@dnd-kit/react": "0.4.0",
    "@elysia/eden": "^1.4.10",
    "@lexical/react": "^0.41.0",
    "@phosphor-icons/react": "^2.1.10",
    "@singapor/core": "0.1.1",
    "@singapor/diff": "0.1.1",
    "@singapor/find": "0.1.1",
    "@singapor/gutters": "0.1.1",
    "@singapor/lsp-plugin": "0.1.1",
    "@singapor/minimap": "0.1.1",
    "@singapor/react": "0.1.1",
    "@singapor/scope-lines": "0.1.1",
    "@singapor/tree-sitter": "0.1.1",
    "@singapor/tree-sitter-languages": "0.1.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "3.13.26",
    "@workspace/contracts": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/tiling": "workspace:*",
    "@workspace/tree": "workspace:*",
    "@workspace/ui": "workspace:*",
    "evlog": "^2.17.0",
    "ghostty-web": "^0.4.0",
    "js.foresight": "^3.5.0",
    "lexical": "^0.41.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.4",
    "react-animated-counter": "^1.9.0",
    "react-dom": "^19.2.4",
    "server": "workspace:*",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "valibot": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser": "^3.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.6.0",
    "globals": "^17.2.0",
    "happy-dom": "^20.10.1",
    "msw": "^2.14.6",
    "oxfmt": "latest",
    "oxlint": "latest",
    "playwright": "^1.59.1",
    "react-scan": "^0.5.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
