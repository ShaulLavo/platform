{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    },
    "./client-contract": {
      "types": "./src/client-contract.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "dev": "bun ../../scripts/run-with-env.ts --watch src/index.ts",
    "server": "bun --env-file=../../.env src/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env dist/index.js",
    "build": "tsgo --noEmit && bun build src/index.ts --target bun --outdir dist --external @parcel/watcher",
    "codex-protocol:check": "bun src/provider/adapters/codex-protocol/generate.ts --check",
    "codex-protocol:generate": "bun src/provider/adapters/codex-protocol/generate.ts",
    "test": "bun --bun vitest run",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@lydell/node-pty": "1.1.0",
    "@parcel/watcher": "^2.5.6",
    "@singapor/lsp": "0.1.1",
    "@singapor/typescript-lsp": "0.1.1",
    "@tanstack/pacer": "^0.21.1",
    "@workspace/contracts": "workspace:*",
    "@workspace/observability": "workspace:*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "evlog": "^2.17.0",
    "jszip": "^3.10.1",
    "subset-font": "^2.5.0",
    "typescript": "^5.9.3",
    "valibot": "^1.4.0",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.1.0",
    "@types/subset-font": "^2.3.0",
    "@typescript/native-preview": "latest",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.2.4"
  }
}
