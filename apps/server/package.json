{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "server": "bun --env-file=../../.env src/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env dist/index.js",
    "build": "tsgo --noEmit && bun build src/index.ts --target bun --outdir dist --external @parcel/watcher",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@editor/lsp": "workspace:*",
    "@editor/typescript-lsp": "workspace:*",
    "@elysia/eden": "^1.4.10",
    "@elysiajs/cors": "^1.4.2",
    "@lydell/node-pty": "1.1.0",
    "@parcel/watcher": "^2.5.6",
    "@workspace/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "evlog": "^2.17.0",
    "typescript": "^5.9.3",
    "valibot": "^1.4.0",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.1.0",
    "@typescript/native-preview": "latest",
    "eslint": "^9.39.2",
    "fast-check": "^4.6.0",
    "globals": "^17.2.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript-eslint": "^8.54.0"
  }
}
